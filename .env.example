# Crypto SuperChat Configuration

# Required: Blockchain API
HELIUS_API_KEY=your_helius_api_key_here
WALLET_ADDRESS=your_solana_wallet_address_here

# Required: x402 Payment
PAY_TO_ADDRESS=your_payment_address_here
FACILITATOR_URL=https://facilitator.x402.rs

# Token Configuration
WHITELISTED_TOKENS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# x402 Settings
X402_NETWORK=solana
X402_MAX_AMOUNT=10000
X402_TIMEOUT=60
DEFAULT_DONATION_AMOUNT="0.01"

# Content Limits
MAX_SENDER_NAME_LENGTH=12
MAX_MESSAGE_LENGTH=200

# Database
DATABASE_URL=sqlite:///donations.db

# Encryption (see README for key generation)
ENCRYPTION_KEY=

# Data Retention
PAYMENT_PROOF_RETENTION_HOURS=48

# Server
PORT=8765

# Logging
# Set to "true" for verbose debug logging
ENABLE_DEBUG_LOGGING=false
# Optional: Log to file (in addition to stdout). Leave empty to disable file logging.
# When using systemd, logs go to journald anyway, so this is optional.
LOG_FILE=
